{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ltx-2.3-22b-dev-fp8.safetensors"
    }
  },
  "2": {
    "class_type": "LatentUpscaleModelLoader",
    "inputs": {
      "model_name": "ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
    }
  },
  "3": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "{{VIDEO_FILE}}"
    }
  },
  "4": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["3", 0]
    }
  },
  "5": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": ["4", 0],
      "vae": ["1", 2],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "6": {
    "class_type": "LTXVLatentUpsampler",
    "inputs": {
      "samples": ["5", 0],
      "upscale_model": ["2", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2],
      "tile_size": 768,
      "overlap": 64,
      "temporal_size": 4096,
      "temporal_overlap": 4
    }
  },
  "8": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["7", 0],
      "fps": 25.0,
      "audio": ["4", 1]
    }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["8", 0],
      "filename_prefix": "ltx-upscale",
      "format": "mp4",
      "codec": "auto"
    }
  }
}
